NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
DATABASE_URL=
OPENAI_API_KEY=
NEXT_PUBLIC_WEBSOCKET_URL=ws://localhost:1234

# Optional for future API work; ignored by the local Codex prototype.
OPENAI_MODEL=
# Optional path if codex is not on the Next.js process PATH.
CODEX_CLI_PATH=
# Raw Yjs-update prototype server; distinct from the y-websocket setting above.
NEXT_PUBLIC_PROTOTYPE_WEBSOCKET_URL=ws://127.0.0.1:1234
